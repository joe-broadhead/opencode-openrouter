    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "openrouter",
        "label": "OpenRouter tools",
        "server": "openrouter"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "ask-changes",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
